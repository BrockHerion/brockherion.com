---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/content';

const { projects, cacheHint } = await getProjects();
Astro.cache.set(cacheHint);
---

<BaseLayout title="Projects — Brock Herion" description="Software Brock Herion has built and shipped — products, side projects, and experiments, with notes on each."
  image="/og/page-projects.png">
  <div class="gutter py-16">
    <PageHeader title="Projects">
      <p class="mono text-[10px] tracking-[0.12em] text-muted pb-2">Things I've built</p>
    </PageHeader>

    <div class="grid grid-cols-1 band:grid-cols-2 gap-6 mt-10">
      {projects.map(project => (
        <ProjectCard
          title={project.title}
          description={project.description}
          url={project.url}
          repo={project.repo}
          kicker={project.url ? 'Shipping' : 'In progress'}
        />
      ))}
    </div>
  </div>
</BaseLayout>
