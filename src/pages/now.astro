---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { dateMonthStamp } from '../lib/format';
import { frontmatter, Content as NowContent } from '../data/now.md';

const entries: { label: string; value: string }[] = frontmatter.entries ?? [];
const stamp = frontmatter.lastUpdated ? dateMonthStamp(new Date(frontmatter.lastUpdated)) : '';
---

<BaseLayout title="Now — Brock Herion" description="What Brock Herion is doing right now — building, reading, training, and family life."
  image="/og/page-now.png">
  <div class="gutter py-16">
    <div class="max-w-[720px] mx-auto">
      <PageHeader title="Now" stamp={stamp} />

      <!-- The home page's Now list, at page scale. -->
      {entries.length > 0 && (
        <dl class="grid mt-10 text-[18px] leading-[1.6]">
          {entries.map(entry => (
            <div class="grid grid-cols-1 sm:grid-cols-[120px_1fr] gap-x-5 gap-y-1 py-5 border-t border-divider">
              <dt class="mono text-[10px] tracking-[0.1em] text-muted sm:pt-2">{entry.label}</dt>
              <dd class="m-0">{entry.value}</dd>
            </div>
          ))}
        </dl>
      )}

      <div class="rule-hair my-10"></div>

      <div class="prose">
        <NowContent />
      </div>
    </div>
  </div>
</BaseLayout>
