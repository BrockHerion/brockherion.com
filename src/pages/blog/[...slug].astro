---
import { PortableText } from 'emdash/ui';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import Block from '../../components/portable-text/Block.astro';
import Code from '../../components/portable-text/Code.astro';
import { getPost, getPosts } from '../../lib/content';
import { nextReads } from '../../lib/next-reads';
import { headings } from '../../lib/portable-text';

const [{ post, cacheHint }, { posts, cacheHint: postsHint }] = await Promise.all([
  getPost(Astro.params.slug!),
  getPosts(),
]);
// Uncached, so a post published after someone hit its URL is not stuck as a 404.
if (!post) {
  Astro.cache.set(false);
  return new Response(null, { status: 404 });
}
Astro.cache.set(cacheHint);
Astro.cache.set(postsHint);
---

<BlogPostLayout
  title={post.title}
  description={post.description}
  date={post.date}
  updated={post.updated}
  tags={post.tags}
  readingTime={post.readingTime}
  headings={headings(post.content)}
  image={post.image ?? `/og/${post.slug}.png`}
  nextReads={nextReads(post, posts)}
>
  <PortableText value={post.content} components={{ block: Block, type: { code: Code } }} />
</BlogPostLayout>
