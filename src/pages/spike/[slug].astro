---
import { getEmDashCollection, getEmDashEntry } from 'emdash';
import { PortableText } from 'emdash/ui';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import Block from '../../components/portable-text/Block.astro';
import Code from '../../components/portable-text/Code.astro';
import { readingTime } from '../../lib/format';
import { nextReads, type ReadCandidate } from '../../lib/next-reads';
import { headings, plainText } from '../../lib/portable-text';

const [{ entry, error }, { entries, error: listError }] = await Promise.all([
  getEmDashEntry('posts', Astro.params.slug!),
  getEmDashCollection('posts', { limit: 500 }),
]);
if (error) throw error;
if (listError) throw listError;
if (!entry) return new Response(null, { status: 404 });

const toCandidate = (item: typeof entry): ReadCandidate => ({
  slug: item.id,
  title: item.data.title,
  description: item.data.description,
  date: new Date(item.data.publishedAt),
  tags: (item.data.terms?.tag ?? []).map((term: { slug: string }) => term.slug),
});

const post = toCandidate(entry);
const content = entry.data.content ?? [];
---

<BlogPostLayout
  title={post.title}
  description={post.description}
  date={post.date}
  updated={entry.data.updated ? new Date(entry.data.updated) : undefined}
  tags={post.tags}
  readingTime={readingTime(plainText(content))}
  headings={headings(content)}
  image={entry.data.image ?? `/og/${post.slug}.png`}
  nextReads={nextReads(post, entries.map(toCandidate))}
>
  <PortableText value={content} components={{ block: Block, type: { code: Code } }} />
</BlogPostLayout>
