---
/**
 * Every tag search engines and link unfurlers need, in one place.
 *
 * Canonical URLs matter here beyond the usual: the blog index writes
 * `?tag=…` onto its own URL via history.replaceState, so `/blog` is reachable
 * at many query-string URLs that are all the same page. The canonical is built
 * from the pathname alone, which collapses them.
 */

interface Props {
  title: string;
  description: string;
  /** Root-relative or absolute. Defaults to the portrait. */
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  /** Keep the page out of the index — error pages, not real content. */
  noindex?: boolean;
  /** Emit ProfilePage schema instead of WebSite — the About page. */
  profile?: boolean;
}

const {
  title,
  description,
  image = '/og/site.png',
  type = 'website',
  publishedDate,
  updatedDate,
  tags = [],
  noindex = false,
  profile = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://brockherion.com');
const canonical = new URL(Astro.url.pathname, site);
const imageUrl = new URL(image, site);

const person = {
  '@type': 'Person',
  name: 'Brock Herion',
  url: site.href,
  image: new URL('/avatar.jpeg', site).href,
  sameAs: [
    'https://github.com/BrockHerion',
    'https://x.com/BrockHerion',
    'https://www.linkedin.com/in/brock-j-herion-34279a176/',
  ],
};

const schema =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: imageUrl.href,
        url: canonical.href,
        mainEntityOfPage: canonical.href,
        datePublished: publishedDate?.toISOString(),
        dateModified: updatedDate?.toISOString(),
        keywords: tags.join(', ') || undefined,
        author: { '@type': 'Person', name: 'Brock Herion', url: site.href },
        publisher: { '@type': 'Person', name: 'Brock Herion', url: site.href },
      }
    : profile
    ? {
        '@context': 'https://schema.org',
        '@type': 'ProfilePage',
        name: title,
        description,
        url: canonical.href,
        mainEntity: person,
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'Brock Herion',
        description,
        url: site.href,
        author: person,
      };
---

{noindex ? (
  <meta name="robots" content="noindex, follow" />
) : (
  <link rel="canonical" href={canonical.href} />
)}

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={imageUrl.href} />
{/* Every card is generated at 1200x630 (scripts/generate-og.mjs); a post
    supplying its own `image` frontmatter must match. */}
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content="Brock Herion" />
<meta property="og:locale" content="en_US" />
{publishedDate && (
  <meta property="article:published_time" content={publishedDate.toISOString()} />
)}
{updatedDate && (
  <meta property="article:modified_time" content={updatedDate.toISOString()} />
)}
{type === 'article' && tags.map(tag => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl.href} />
<meta name="twitter:creator" content="@BrockHerion" />
<meta name="twitter:site" content="@BrockHerion" />

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
