---
const year = new Date().getFullYear();

const links = [
  { href: 'https://github.com/BrockHerion', label: 'GitHub' },
  { href: 'https://x.com/BrockHerion', label: 'X' },
  { href: 'https://www.linkedin.com/in/brock-j-herion-34279a176/', label: 'LinkedIn' },
  { href: '/rss.xml', label: 'RSS' },
];
---

<footer
  class="gutter mono flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-[22px] text-[10px] tracking-[0.12em] text-muted border-t border-divider"
>
  <span class="tnum">&copy; {year} Brock Herion</span>
  <span class="flex flex-wrap gap-5">
    {links.map(link => (
      <a href={link.href} class="no-underline text-muted hover:text-accent transition-colors">
        {link.label}
      </a>
    ))}
  </span>
</footer>
