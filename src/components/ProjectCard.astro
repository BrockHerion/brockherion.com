---
interface Props {
  title: string;
  description: string;
  url?: string;
  repo?: string;
  /** Mono kicker above the title — `Shipping`, `In progress`. */
  kicker?: string;
}

const { title, description, url, repo, kicker } = Astro.props;
---

<article class="card">
  {kicker && <p class="card-kicker tnum">{kicker}</p>}
  <h3 class="card-title">{title}</h3>
  <p class="card-body">{description}</p>
  {(url || repo) && (
    <div class="flex gap-2.5 mt-3.5">
      {url && <a class="btn btn-primary btn-sm" href={url}>Live</a>}
      {repo && <a class="btn btn-secondary btn-sm" href={repo}>Source</a>}
    </div>
  )}
</article>
