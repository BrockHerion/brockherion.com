---
interface Props {
  tags: string[];
  /** Link each tag through to the filtered blog index. */
  linked?: boolean;
  /** Right-justify — used in the blog index's third column. */
  align?: 'start' | 'end';
  class?: string;
}

const { tags, linked = false, align = 'start', class: className = '' } = Astro.props;
---

<div
  class:list={[
    'flex flex-wrap gap-1.5',
    align === 'end' && 'justify-end content-start',
    className,
  ]}
>
  {tags.map((tag, i) => {
    // The primary tag carries the accent; the rest stay neutral.
    const variant = i === 0 ? 'tag tag-accent' : 'tag tag-neutral';
    return linked ? (
      <a href={`/blog?tag=${encodeURIComponent(tag)}`} class={variant}>{tag}</a>
    ) : (
      <span class={variant}>{tag}</span>
    );
  })}
</div>
